#!/bin/sh
# Marks the socket's enablement state so postrm can tell a plain removal from
# a purge — the same mask/unmask protocol dh_installsystemduser emits.
set -e

if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    deb-systemd-helper --user mask 'rldyour-sysinfod.socket' >/dev/null || true
fi

exit 0
