<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.nddev-opennetwork.rldyour-sysinfod</string>
  <key>ProgramArguments</key><array><string>@HOME@/.local/bin/rldyour-sysinfod</string></array>
  <!-- Socket activation, the same model systemd uses on Linux: launchd owns
       the socket, spawns the daemon on the first connection, and the daemon
       exits again once the last client has been gone for thirty seconds.
       SockPathMode 384 is octal 0600 — owner only. -->
  <key>Sockets</key><dict>
    <key>sock</key><dict>
      <key>SockPathName</key><string>@HOME@/Library/Application Support/rldyour-sysinfo/rldyour-sysinfo.sock</string>
      <key>SockPathMode</key><integer>384</integer>
    </dict>
  </dict>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/rldyour-sysinfod.log</string>
</dict></plist>
